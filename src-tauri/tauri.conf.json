{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TerSterm",
  "version": "0.1.14",
  "identifier": "com.tersterm.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TerSterm",
        "width": 1665,
        "height": 1039,
        "visible": false,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false,
        "minWidth": 1040,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tersterm"]
      }
    }
  }
}
